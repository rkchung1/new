# LLM backend: openai | vllm
LLM_BACKEND=openai
LLM_TIMEOUT_SEC=120
LLM_MAX_TOKENS=1024

# Rolling feature cache window (seconds) for BTC tape + per-market book history
MARKET_HISTORY_SEC=900

# OpenAI (when LLM_BACKEND=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# vLLM OpenAI-compatible server (when LLM_BACKEND=vllm)
# Start server: vllm serve <model> --port 8000
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=
VLLM_API_KEY=EMPTY
